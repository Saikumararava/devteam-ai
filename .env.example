# Copy to .env in the repo root and/or backend/.env
APP_NAME=DevTeam AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Local Ollama (no cloud AI APIs)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=2048

DATABASE_URL=sqlite:///./data/devteam.db
GENERATED_PROJECTS_DIR=../generated_projects
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker sandbox (used in later phases; optional)
DOCKER_ENABLED=false
SANDBOX_IMAGE=devteam-ai-sandbox:local
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
